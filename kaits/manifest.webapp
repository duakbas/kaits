{
  "version": "0.0.2",
  "name": "Kaits",
  "description": "Chat client - talks to your own wad daemon",
  "type": "web",
  "launch_path": "/index.html",
  "icons": {
    "32": "/icons/icon-32.png",
    "48": "/icons/icon-48.png",
    "56": "/icons/icon-56.png",
    "64": "/icons/icon-64.png",
    "112": "/icons/icon-112.png",
    "128": "/icons/icon-128.png",
    "256": "/icons/icon-256.png"
  },
  "developer": {
    "name": "you"
  },
  "permissions": {
    "desktop-notification": {
      "description": "Notify on new messages and calls"
    },
    "serviceworker": {
      "description": "Background wake for push (KaiOS 2.5 only; 3.0 drops this)"
    },
    "push": {
      "description": "Wake on new message / incoming call"
    },
    "geolocation": {
      "description": "Attach your location to a message when you choose to"
    },
    "device-storage:sdcard": {
      "description": "Attach a file from the memory card. Nothing else on the phone offers documents to other apps, so this is the only way to reach one.",
      "access": "readonly"
    }
  },
  "messages": [
    {
      "serviceworker-notification": "/index.html"
    }
  ],
  "locales": {
    "en-US": {
      "name": "Kaits",
      "subtitle": "Chat client for a self-hosted daemon",
      "description": "Chat client - talks to your own wad daemon"
    }
  },
  "default_locale": "en-US",
  "cursor": false
}