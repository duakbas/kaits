{
  "name": "WhatsApp",
  "description": "WhatsApp client (thin) — talks to the wad daemon",
  "type": "privileged",
  "launch_path": "/index.html",
  "icons": {
    "56": "/icons/icon-56.png",
    "112": "/icons/icon-112.png"
  },
  "developer": {
    "name": "you"
  },
  "permissions": {
    "desktop-notification": {
      "description": "Notify on new messages and calls"
    },
    "audio-capture": {
      "description": "Microphone for voice calls"
    },
    "serviceworker": {
      "description": "Background wake for push"
    },
    "push": {
      "description": "Wake on new message / incoming call"
    },
    "contacts": {
      "description": "Save a chat's number to the phone's address book",
      "access": "readcreate"
    }
  },
  "default_locale": "en",
  "cursor": false
}
